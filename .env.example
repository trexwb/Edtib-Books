# ─────────────────────────────────────────────────────────────
# Edtib Books（紧固助手）环境变量模板（复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略）
#
# 分为三组：
#   A. 前端（Vite，VITE_ 前缀）：编译进渲染层产物
#   B. 桌面端 Rust（TAURI_ 本地密钥 / EDTIB_ 运行时配置）：运行期读取，进程环境变量优先，
#      其次读密钥文件 <AppData>/books.env（可用 EDTIB_ENV_FILE 指定绝对路径）
#      —— 打包后的应用从 Finder / 快捷方式启动不会继承 shell 环境，
#         因此生产分发请写入 books.env，由首次启动前放置。
#   C. Rust 构建期（option_env! 编译注入）
#
# [框架统一] 前缀约定与 console 一致：TAURI_* = 桌面端密钥；EDTIB_* = 与密钥无关的运行时配置。
# books 已改为与 console 同款的代理模型（渲染层 → 本地 tauri http 服务 → 网关），因此有两套密钥，职责不同：
#   · A 组 VITE_APP_*  ↔  B 组 TAURI_LINK_*：「本地链路对」（渲染层 ↔ tauri http 服务），
#     必须是同一对——渲染层用它加密请求体、算 App-Secret，tauri 用它验签并加解密回包；
#     不一致直接 4016000305。`npm run tauri:dev` 由 scripts/with-tauri-env.mjs 自动做这层映射。
#   · B 组 TAURI_APP_* + TAURI_APP_BASE_URL：tauri http 服务「出站调用后端网关」的凭证与地址，
#     属于后端密钥，禁止出现在渲染层产物里；正式口径为本地 secrets 表的有效行，环境变量仅作缺省兜底。
# 本地构建签名私钥：npm run tauri -- signer generate -p 密码 -w ~/.tauri/EdtibBooks-updater.key
# ─────────────────────────────────────────────────────────────

# NODE_ENV禁止修改
NODE_ENV=development

# ===== A. 前端构建期（Vite，import.meta.env.*）=====
# [框架统一] 前端七键契约——三套环境文件必须成对齐全，books / console 结构一致：
#   VITE_APP_ID / VITE_APP_SECRET / VITE_APP_IV / VITE_APP_BASE_URL /
#   VITE_REQUEST_ENCRYPT / VITE_RETURN_ENCRYPT / VITE_ASSETS_BASE_URL
# 口径（命令决定使用哪个环境文件）：
#   npm run dev        → .env.development：浏览器直连接口服务（VITE_APP_* 即网关凭证，
#                        VITE_APP_BASE_URL 经 vite /api 代理转发），B 组 TAURI_* 不参与
#   npm run tauri:dev  → .env.test：渲染层只调用本地 tauri http 服务（VITE_APP_* = 本地链路密钥，
#                        需与 <AppData>/books.env 的 TAURI_LINK_* 同一对），
#                        再由 tauri 用 TAURI_APP_* 请求 TAURI_APP_BASE_URL 对应的服务
#   npm run build      → .env.production：与 tauri:dev 同样的代理链路，凭证换成正式一套
# ⚠️ A 组值会编译进渲染层产物：代理模式下只放「本地链路对」，网关凭证一律走 B 组 TAURI_APP_*
VITE_APP_ID=
VITE_APP_SECRET=
# 16 字符固定 IV：仅用于解密老格式固定 IV 密文（新请求/回包一律随机 IV，格式 iv(hex):密文(hex)）
VITE_APP_IV=
VITE_APP_BASE_URL='/api'
VITE_REQUEST_ENCRYPT=true
VITE_RETURN_ENCRYPT=true
VITE_ASSETS_BASE_URL=
# 商业模板授权码（缺失时 vite 插件链仍完整注册，但会打印授权无效提示且不产出 dist/）
VITE_APP_GITHUB_USER_NAME=
VITE_APP_SECRET_KEY=

# ===== B. Rust 运行期（TAURI_ 密钥 / EDTIB_ 运行时配置）=====
# 本地链路凭证：与 .env.test / .env.production 里的 VITE_APP_ID / VITE_APP_SECRET / VITE_APP_IV 完全相同
#（`npm run tauri:dev` 由 with-tauri-env.mjs 自动映射，只需维护 <AppData>/books.env 这一份）
TAURI_LINK_ID=
TAURI_LINK_SECRET=
TAURI_LINK_IV=

# 出站网关凭证：tauri http 服务调用后端接口时使用。
# 取值优先级：本地 secrets 表有效行（status=1）> 这里的环境变量 / 密钥文件。
# 注意（2026-10 加固后的口径，与 console 一致）：
#   · 源码里不再内置任何 dev/prod 兜底地址。TAURI_APP_BASE_URL 与 secrets.app_url
#     同时缺失时，代理直接以「缺少出站网关地址」失败，不会静默挑一个网关；
#   · 两者都配置时必须同源，否则按「配置网关地址与本地 secrets.app_url 不一致」拒绝转发；
#   · 正式包（release 构建）只允许出网到 config::ALLOWED_GATEWAY_ORIGINS 列出的自有域名；
#   · 开发/测试构建（tauri:dev）默认拒绝访问正式网关，确需联调正式环境时显式设
#     EDTIB_ALLOW_PROD_EGRESS=1（与 with-tauri-env.mjs 的 EDTIB_TAURI_ALLOW_PROD_ENV 同一口径）；
#   · 正式网关凭证不要写进本仓库的任何 .env*：产物扫描（npm run scan:dist）会把
#     出现在 .env* 里的 TAURI_APP_* 视为应进入密钥文件的值，出现进 Web 资源即构建失败。
TAURI_APP_ID=
TAURI_APP_SECRET=
TAURI_APP_IV=
TAURI_APP_BASE_URL=https://gateway-dev.edtib.com/api
# 开发期联调正式网关的显式放行开关（默认关闭，正式包不需要）
# EDTIB_ALLOW_PROD_EGRESS=1
# tauri:dev 的环境来源（默认 .env.test）。指向 .env.production / .env.stage 会被
# with-tauri-env.mjs 拒绝，除非同时设置 EDTIB_TAURI_ALLOW_PROD_ENV=1
# EDTIB_TAURI_ENV=.env.test

# SQLCipher 主密钥（64 位十六进制）。留空时按 macOS Keychain → <AppData>/.sqlcipher-key 取用或生成
TAURI_DB_KEY_HEX=
# 本地库字段级 AES-256-CBC 密钥；留空则字段加解密关闭（明文透传）。
# 长度为 32 时走 console 同构模式（utf8 原始密钥，写出 iv(hex):密文(hex)）；
# 其他长度沿用 books 老派生模式（key=sha256(secret)，写出 hex(iv||cipher)），两种密文读取侧互相兼容
TAURI_FIELD_CRYPT_SECRET=
# 显式配置 16 字符 IV = 与老 Electron 数据互读写的固定 IV 兼容模式；留空则写出随机 IV 前置
TAURI_FIELD_CRYPT_IV=
# 应用数据目录覆盖（测试 / 自定义部署），留空用平台默认 AppData
EDTIB_DATA_DIR=
EDTIB_LEGACY_DATA_DIR=
# 更新清单地址（逗号 / 分号 / 换行分隔可多个），覆盖 tauri.conf.json 的 plugins.updater.endpoints
EDTIB_UPDATER_ENDPOINT=
# 密钥文件路径覆盖（默认 <AppData>/books.env）
# EDTIB_ENV_FILE=/absolute/path/to/books.env

# ===== C. Rust 构建期（cargo build / tauri build 前 export，option_env! 注入）=====
# 版本号文案：{EDTIB_VERSION_ALIAS}-v{version}({EDTIB_VERSION_TIMER})，未注入时回落纯版本号
EDTIB_VERSION_ALIAS=
EDTIB_VERSION_TIMER=

# ===== 打包 / 更新签名（构建期 shell 环境变量，不落 books.env）=====
# 更新产物签名私钥（Tauri updater）。路径指向本机 ~/.tauri/EdtibBooks-updater.key
TAURI_SIGNING_PRIVATE_KEY_PATH="~/.tauri/EdtibBooks-updater.key"
# 私钥密码（生成密钥时设置的密码）
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# 方式二（备用）：内联私钥内容——仅当第三方 CI 不支持 PATH 形式时启用：
# 1) 注释掉上面的 PATH 行  2) 取消下行注释并粘贴 ~/.tauri/EdtibBooks-updater.key 全文
# export TAURI_SIGNING_PRIVATE_KEY="
# （密钥文件全文，含首行 untrusted comment）
# "
