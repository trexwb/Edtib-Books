# 本地构建签名环境模板（复制为 .env.local 后填入真实值）
# .env.local 已被 .gitignore 忽略，勿提交
# 生成密钥：npm run tauri -- signer generate -p 密码 -w ~/.tauri/EdtibConsole-updater.key

# 更新产物签名私钥（Tauri updater）。路径指向本机 ~/.tauri/EdtibConsole-updater.key
TAURI_SIGNING_PRIVATE_KEY_PATH="~/.tauri/EdtibConsole-updater.key"
# 私钥密码（生成密钥时设置的密码）
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# 方式二（备用）：内联私钥内容——仅当第三方 CI 不支持 PATH 形式时启用：
# 1) 注释掉上面的 PATH 行  2) 取消下行注释并粘贴 ~/.tauri/EdtibConsole-updater.key 全文
# export TAURI_SIGNING_PRIVATE_KEY="
# （密钥文件全文，含首行 untrusted comment）
# "

# NODE_ENV禁止修改
NODE_ENV=development

# ===== A. 前端构建期（Vite，import.meta.env.*）=====
# ⚠️ 前端密钥随构建产物分发，务必与 Rust 侧口径一致
VITE_APP_ID=
VITE_APP_SECRET=
VITE_APP_IV=
VITE_APP_BASE_URL='/api'
VITE_REQUEST_ENCRYPT=true
VITE_RETURN_ENCRYPT=true
VITE_ASSETS_BASE_URL=
# 商业模板授权码（缺失时 vite 插件链仍完整注册，但会打印授权无效提示且不产出 dist/）
VITE_APP_GITHUB_USER_NAME=
VITE_APP_SECRET_KEY=

# ===== B. Rust 运行期（打包态不继承 shell 环境变量，需由启动脚本 / launchd 注入）=====
# SQLCipher 主密钥（64 位十六进制）。留空时按 macOS Keychain → <AppData>/.sqlcipher-key 取用或生成
EDTIB_DB_KEY_HEX=
# 本地库字段级 AES-256-CBC 密钥；留空则字段加解密关闭（明文透传）
EDTIB_FIELD_CRYPT_SECRET=
# 显式配置 IV = 与老 Electron 数据互读写的固定 IV 兼容模式；留空则写出随机 IV 前置
EDTIB_FIELD_CRYPT_IV=
# 应用数据目录覆盖（测试 / 自定义部署），留空用平台默认 AppData
EDTIB_DATA_DIR=
EDTIB_LEGACY_DATA_DIR=
# 更新清单地址（逗号 / 换行分隔可多个），覆盖 tauri.conf.json 的 plugins.updater.endpoints
EDTIB_UPDATER_ENDPOINT=

# ===== C. Rust 构建期（cargo build / tauri build 前 export，option_env! 注入）=====
# 版本号文案：{EDTIB_VERSION_ALIAS}-v{version}({EDTIB_VERSION_TIMER})，未注入时回落纯版本号
EDTIB_VERSION_ALIAS=
EDTIB_VERSION_TIMER=